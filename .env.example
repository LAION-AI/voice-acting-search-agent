# Copy to .env and fill in (run_agent.py & tools read these from the environment).
# NOTE: real tokens must never be committed — GitHub auto-revokes any live ghp_ token
# pushed to a public repo. Keep them in .env (gitignored).
# HF token: model downloads (MOSS-VA-v2, codec, scorer models, LoRAs, Gemma)
HF_TOKEN=hf_your_token_here
# GitHub token with repo write on LAION-AI/voice-acting-search-agent (push_results tool)
GITHUB_TOKEN=ghp_your_token_here
# Caches (keep off small tmpfs partitions)
HF_HOME=/tmp/hf_cache
HF_HUB_DISABLE_XET=1
